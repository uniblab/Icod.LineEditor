+		private SedCompiledRegularExpression CompileRegularExpression(
+			string pattern,
+			SedRegularExpressionContext context,
+			bool ignoreCase,
+			bool multiline
+		) {
+			try {
+				return this.myRegularExpressions.Compile(
+					pattern,
+					context,
+					ignoreCase,
+					multiline
+				);
+			} catch ( ScriptParseException ex ) {
+				throw this.Error(
