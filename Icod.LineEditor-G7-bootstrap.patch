+		private void RequireFileAccess() {
+			if ( this.mySandbox ) {
+				throw this.Error(
+					"file access commands are disabled in sandbox mode"
+				);
+			}
+		}
+
+		private void RequireBoundary() {
+			if (
+				this.myIndex < this.myText.Length
+				&& !this.IsCommandSeparator(
+					this.myText[ this.myIndex ]
+				)
+				&& '}' != this.myText[ this.myIndex ]
+				&& !char.IsWhiteSpace(
+					this.myText[ this.myIndex ]
