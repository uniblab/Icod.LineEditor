+		var script = string.Join(
+			'\n',
+			"1ka",
+			"2d",
+			"1x",
+			"'ap",
+			"u",
+			"1,$p",
+			string.Empty
+		);
+
+		var result = await engine.ExecuteScriptAsync(
+			StreamOf( script ),
+			output,
+			error
+		);
+
+		Assert.True( result.IsSuccess );
