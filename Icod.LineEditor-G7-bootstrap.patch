+		Assert.Equal( EditorExitStatus.Interrupted, result.ExitStatus );
+		Assert.Equal( EditorDiagnosticCode.Interrupted, result.Diagnostic?.Code );
+	}
+
+	private static EditorEngine CreateEngine(
+		MemoryFileAccess? files = null,
