+/// <param name="Lines">The stable lines in address order.</param>
+/// <param name="NextLineId">The next identity to allocate.</param>
+internal sealed record BufferSnapshot(
+	IReadOnlyList<EditorLine> Lines,
+	long NextLineId
+);
