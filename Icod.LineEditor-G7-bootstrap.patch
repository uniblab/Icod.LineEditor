+				var read = await this.fileAccess.ReadAsync( path, cancellationToken ).ConfigureAwait( false );
+				if ( captureUndo ) {
+					this.CaptureUndo();
+				}
+				var inserted = this.Buffer.InsertAfter( address, read.Lines );
+				this.CurrentAddress = 0 == inserted.Start ? address : inserted.End;
