+					throw new EditorCommandException( EditorDiagnosticCode.InvalidCommand, "The cut buffer is empty." );
+				}
+				if ( captureUndo ) {
+					this.CaptureUndo();
+				}
+				var inserted = this.Buffer.InsertAfter( address, this.cutBuffer );
