+				return new CommandOutcome( scriptIndex, false );
+			}
+			case 'q':
+				if ( this.IsModified ) {
+					throw new EditorCommandException( EditorDiagnosticCode.ModifiedBuffer, "The buffer has unsaved changes." );
+				}
