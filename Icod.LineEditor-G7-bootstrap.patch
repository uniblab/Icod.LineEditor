+				this.CurrentAddress = changed.LastChangedAddress;
+				this.IsModified = true;
+				if ( changed.PrintChanged ) {
+					await this.PrintRangeAsync(
+						new EditorAddressRange( this.CurrentAddress, this.CurrentAddress ),
+						standardOutput,
+						PrintMode.Plain,
+						cancellationToken
